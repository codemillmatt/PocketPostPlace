---
import '../styles/global.css';
import { BASE_PATH, NEW_POST_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
} = Astro.props;

const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<script is:inline>
			try {
				const storedTheme = sessionStorage.getItem('theme-preference');
				if (storedTheme === 'light' || storedTheme === 'dark') {
					document.documentElement.dataset.theme = storedTheme;
				}
			} catch {}
		</script>
		<title>{title}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="site-title" href={`${BASE_PATH}/`}>{SITE_TITLE}</a>
				<div class="site-actions">
					<nav class="site-nav" aria-label="Primary">
						<a href={`${BASE_PATH}/`}>Home</a>
						<a href={`${BASE_PATH}/new/`}>New post</a>
						<a href={NEW_POST_URL} target="_blank" rel="noreferrer">Open issue</a>
					</nav>
					<button
						type="button"
						class="theme-toggle"
						data-theme-toggle
						aria-label="Switch to dark mode"
					>
						<span class="theme-toggle-icon theme-toggle-icon--light" aria-hidden="true">☀️</span>
						<span class="theme-toggle-icon theme-toggle-icon--dark" aria-hidden="true">🌙</span>
						<span data-theme-label>Light mode</span>
					</button>
				</div>
			</header>
			<main class="site-main">
				<slot />
			</main>
		</div>
		<script>
			import { setupThemeToggle } from '../lib/theme-toggle';

			setupThemeToggle();
		</script>
	</body>
</html>
