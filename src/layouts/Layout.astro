---
import '../styles/global.css';
import { BASE_PATH, NEW_POST_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { DARK_THEME, LIGHT_THEME, THEME_STORAGE_KEY } from '../lib/theme';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
} = Astro.props;

const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<script
			is:inline
			define:vars={{ themeStorageKey: THEME_STORAGE_KEY, lightTheme: LIGHT_THEME, darkTheme: DARK_THEME }}
		>
			try {
				const storedTheme = sessionStorage.getItem(themeStorageKey);
				if (storedTheme === lightTheme || storedTheme === darkTheme) {
					document.documentElement.dataset.theme = storedTheme;
				}
			} catch {}
		</script>
		<title>{title}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="site-title" href={`${BASE_PATH}/`}>{SITE_TITLE}</a>
				<div class="site-actions">
					<nav class="site-nav" aria-label="Primary">
						<a href={`${BASE_PATH}/`}>Home</a>
						<a href={`${BASE_PATH}/new/`}>New post</a>
						<a href={NEW_POST_URL} target="_blank" rel="noreferrer">Open issue</a>
					</nav>
					<button
						type="button"
						class="theme-toggle"
						data-theme-toggle
						aria-label="Switch to dark mode"
					>
						<svg
							class="theme-toggle-icon theme-toggle-icon--light"
							aria-hidden="true"
							viewBox="0 0 24 24"
							focusable="false"
						>
							<path
								fill="currentColor"
								d="M12 4a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm0 13a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1Zm8-5a1 1 0 0 1-1 1h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1ZM7 13H6a1 1 0 1 1 0-2h1a1 1 0 1 1 0 2Zm9.66-5.25a1 1 0 0 1-1.42 0l-.71-.7a1 1 0 1 1 1.42-1.42l.71.7a1 1 0 0 1 0 1.42ZM9.46 15.95a1 1 0 0 1-1.42 0l-.7-.7a1 1 0 1 1 1.42-1.42l.7.7a1 1 0 0 1 0 1.42Zm7.2-.7.71-.7a1 1 0 1 1 1.42 1.42l-.71.7a1 1 0 1 1-1.42-1.42Zm-7.2-7.2.7-.7A1 1 0 1 0 8.75 5.93l-.7.7a1 1 0 0 0 1.41 1.42ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"
							/>
						</svg>
						<svg
							class="theme-toggle-icon theme-toggle-icon--dark"
							aria-hidden="true"
							viewBox="0 0 24 24"
							focusable="false"
						>
							<path
								fill="currentColor"
								d="M14.53 3.5a1 1 0 0 1 .69 1.73 7.5 7.5 0 1 0 8.55 8.55 1 1 0 0 1 1.73.69 9.5 9.5 0 1 1-10.97-10.97Z"
							/>
						</svg>
						<span data-theme-label>Light mode</span>
					</button>
				</div>
			</header>
			<main class="site-main">
				<slot />
			</main>
		</div>
		<script>
			import { setupThemeToggle } from '../lib/theme-toggle';

			setupThemeToggle();
		</script>
	</body>
</html>
